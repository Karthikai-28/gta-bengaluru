# Absolute path to the Unreal Engine source/binary installation.
UE_ROOT=/home/your-user/dev/engines/UnrealEngine

# Backup destination on a different disk or synchronized volume.
NAMMA_BACKUP_ROOT=/mnt/backups/namma-city

# Optional: prefix of a locally built Mesa, for hosts whose distribution driver
# is older than 24.2 and therefore lacks VK_KHR_dynamic_rendering_local_read.
# Build one with Scripts/build_local_mesa.sh. Leave unset to use the system
# driver.
# MESA_PREFIX=/home/your-user/dev/mesa-26
